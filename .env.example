# FreshAF configuration — copy to .env and fill in for production.

PORT=5757
# Set to your public https URL in production (used for PayFast redirects + webhooks)
BASE_URL=http://localhost:5757
# Set to "production" on the host (enables secure cookies behind TLS)
NODE_ENV=development

# Admin login (seeded on first run only; delete data/freshaf.db to re-seed)
ADMIN_EMAIL=admin@freshaf.co.za
ADMIN_PASSWORD=FreshAF!Admin2026

# Card payments master switch. Must be exactly "true" before any card flow goes live,
# even when merchant keys are present. Leave blank to run cash-only + sandbox.
PAYMENTS_LIVE=

# Which card gateway to use: stitch (default) or payfast.
PAYMENT_PROVIDER=stitch

# --- Stitch (stitch.money) ---------------------------------------------------
# Sign up at https://express.stitch.money. Keys come from the Stitch dashboard.
# Card payments stay off until PAYMENTS_LIVE=true AND these are filled in.
# Your BASE_URL domain must be allowlisted with Stitch for redirects to work, and
# the webhook below must point at https://<your domain>/api/payments/stitch/webhook
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
# Scope for the hosted card payment-request flow. Only change if Stitch tells you to.
STITCH_SCOPE=client_paymentrequest
# Where the money settles. Either a Stitch merchant id, OR FreshAF's own bank account.
# The two are mutually exclusive.
STITCH_MERCHANT_ID=
STITCH_BENEFICIARY_NAME=FRESHAF (PTY) LTD
STITCH_BENEFICIARY_BANK_ID=fnb
STITCH_BENEFICIARY_ACCOUNT_NUMBER=

# PayFast merchant credentials — leave blank to run card payments in sandbox mode.
# Register at https://www.payfast.co.za, then paste your keys here to go live.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Optional: pin the JWT secret (otherwise one is generated and stored in data/jwt.secret)
JWT_SECRET=

# WhatsApp job alerts (Meta WhatsApp Cloud API). Leave blank to run in dry-run mode:
# alerts are logged to the whatsapp_log table and the console instead of being sent.
# Full walkthrough, including the two message templates you must register: WHATSAPP-SETUP.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_JOB=freshaf_job_alert
WHATSAPP_TEMPLATE_CODE=freshaf_verify_code
WHATSAPP_TEMPLATE_LANG=en

# Account emails (pro application received / approved / rejected, and new-pro alerts to admin).
# Sends through GoDaddy Professional Email. Leave SMTP_PASS blank for dry run (console only).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=admin@freshaf.io
SMTP_PASS=
ADMIN_NOTIFY_EMAIL=admin@freshaf.io
