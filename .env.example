# FreshAF configuration — copy to .env and fill in for production.

PORT=5757
# Set to your public https URL in production (used for PayFast redirects + webhooks)
BASE_URL=http://localhost:5757
# Set to "production" on the host (enables secure cookies behind TLS)
NODE_ENV=development

# Admin login (seeded on first run only; delete data/freshaf.db to re-seed)
ADMIN_EMAIL=admin@freshaf.co.za
ADMIN_PASSWORD=FreshAF!Admin2026

# Card payments master switch. Must be exactly "true" before any card flow goes live,
# even when merchant keys are present. Leave blank to run cash-only + sandbox.
PAYMENTS_LIVE=

# Which card gateway to use: stitch (default) or payfast.
PAYMENT_PROVIDER=stitch

# --- Stitch Express ----------------------------------------------------------
# Settings -> Developers at https://express.stitch.money.
# Card payments stay off until PAYMENTS_LIVE=true AND these are filled in.
#
# WARNING: clicking "View Client Secret" in the dashboard REGENERATES the secret.
# The old one stops working immediately, so only look at it when you are ready to
# paste it here. A 400 "invalid_credentials" from the token endpoint usually means
# someone viewed the secret since this value was set.
#
# Test credentials are prefixed "test-" and charge nobody.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# From the webhook endpoint in the dashboard. It cannot be fetched again afterwards.
STITCH_WEBHOOK_SECRET=
# Scope for payment links. Only change if Stitch tells you to.
STITCH_SCOPE=client_paymentrequest
#
# Stitch Express settles into the bank account verified on the account, so there is
# no beneficiary to configure here. BASE_URL + /payment-complete must be registered
# as a redirect URL, WITHOUT a trailing slash, or customers hit a 404 after paying.
# `npm run stitch:check` verifies that for you.

# PayFast merchant credentials — leave blank to run card payments in sandbox mode.
# Register at https://www.payfast.co.za, then paste your keys here to go live.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Optional: pin the JWT secret (otherwise one is generated and stored in data/jwt.secret)
JWT_SECRET=

# WhatsApp job alerts (Meta WhatsApp Cloud API). Leave blank to run in dry-run mode:
# alerts are logged to the whatsapp_log table and the console instead of being sent.
# Full walkthrough, including the two message templates you must register: WHATSAPP-SETUP.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_JOB=freshaf_job_alert
WHATSAPP_TEMPLATE_CODE=freshaf_verify_code
WHATSAPP_TEMPLATE_LANG=en

# Account emails (pro application received / approved / rejected, and new-pro alerts to admin).
# Sends through GoDaddy Professional Email. Leave SMTP_PASS blank for dry run (console only).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=admin@freshaf.io
SMTP_PASS=
ADMIN_NOTIFY_EMAIL=admin@freshaf.io

# --- Google Maps Platform ------------------------------------------------------
# Optional. Without it, address search falls back to OpenStreetMap and distances
# fall back to straight-line, which is what shipped before.
#
# With it you get South African house numbers in address search, and the callout
# fee is priced on the real driving distance instead of a straight line over a
# mountain. Enable "Places API (New)" and "Routes API" on the key.
#
# This key is used SERVER-SIDE ONLY and must never be put in a page. Restrict it
# by API (Places + Routes) in the Google Cloud console; an IP restriction will not
# work on Render, whose outbound addresses change.
GOOGLE_MAPS_API_KEY=
