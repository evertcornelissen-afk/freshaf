backups/

# Capacitor copies public/ into the native projects on `cap sync`. The native project
# scaffolding IS committed (the iOS one has to be opened on a Mac, so it must travel),
# but these copies are build output and would duplicate the whole site on every sync.
android/app/src/main/assets/public/
ios/App/App/public/
android/.gradle/
android/build/
android/app/build/
android/local.properties
ios/App/Pods/
ios/App/Podfile.lock
ios/App/App.xcworkspace/

forms/
# Documents we send to pros are built into the Desktop FreshAF folder (see marketing/outdir.py),
# so there is exactly one copy of each on disk and it is the one that gets emailed.

# Android upload key: never commit. Back it up in the password manager (APP-STORE-SUBMISSION.md A3).
android/keystore.properties
*.jks
*.keystore
android/app/google-services.json
