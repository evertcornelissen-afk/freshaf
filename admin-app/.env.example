# FreshAF Admin — local configuration. Copy to .env and fill in.

# The live site this dashboard manages.
FRESHAF_URL=https://freshaf.io

# Must match ADMIN_API_KEY on Render exactly. Without it every admin call returns 404.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=

# Local only. 127.0.0.1 means nothing else on your network can reach this.
ADMIN_PORT=5858
ADMIN_BIND=127.0.0.1

# --- Publishing it (admin.freshaf.io) -----------------------------------------
# Only for a HOSTED instance. On your own machine leave this unset.
#
# Set ADMIN_BIND=0.0.0.0 above so Render can route to it. There is no second shared
# password: the admin key is attached only to /api/admin/* calls, and only for a caller
# freshaf.io already recognises as a signed-in admin.
#
# Full instructions: admin-app/DEPLOY.md
