# FreshAF Admin — local configuration. Copy to .env and fill in.

# The live site this dashboard manages.
FRESHAF_URL=https://freshaf.io

# Must match ADMIN_API_KEY on Render exactly. Without it every admin call returns 404.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=

# Local only. 127.0.0.1 means nothing else on your network can reach this.
ADMIN_PORT=5858
ADMIN_BIND=127.0.0.1

# --- Publishing it (admin.freshaf.io) -----------------------------------------
# Only for a HOSTED instance. On your own machine leave all three unset.
#
# ADMIN_BIND anything other than 127.0.0.1 means "reachable from outside", and this
# process holds ADMIN_API_KEY. server.js REFUSES TO START in that case unless
# ADMIN_GATE_PASSWORD is set, because otherwise anyone who finds the address gets the
# admin key attached to their requests for free.
#
# Generate the gate password:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# On Render set ADMIN_BIND=0.0.0.0 above, plus both of these.
# Full instructions: admin-app/DEPLOY.md
ADMIN_GATE_USER=freshaf
ADMIN_GATE_PASSWORD=
